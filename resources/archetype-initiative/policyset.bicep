// Deploys the archetype baseline policy set at subscription scope.
// policyset.json is generated by tools/doctrine/doctrine.py from resources/doctrine.json and
// resources/archetypes.json; do not edit it by hand.
targetScope = 'subscription'

var policySet = loadJsonContent('policyset.json')

resource baseline 'Microsoft.Authorization/policySetDefinitions@2023-04-01' = {
  name: policySet.name
  properties: policySet.properties
}

output policySetDefinitionId string = baseline.id
