// Assigns the archetype baseline to a resource group with the effects of one archetype,
// and grants its managed identity the roles that Modify and DeployIfNotExists need in that group.
// assignments.json is generated by tools/doctrine/doctrine.py from resources/doctrine.json and the
// enforcement field of resources/archetypes.json; do not edit it by hand.
targetScope = 'resourceGroup'

@description('Archetype whose effects and parameters are assigned.')
@allowed([
  'corp'
  'online'
  'confidential-corp'
])
param archetype string = 'corp'

@description('Overrides the regions of the archetype (allowed_locations in resources/archetypes.json). Leave empty to use the archetype value.')
param allowedLocations array = []

@description('Resource ID of the Log Analytics workspace that receives security logs. Keep it in this resource group, or grant the role there too.')
param logAnalyticsWorkspaceId string

@description('Region of the assignment managed identity.')
param location string = resourceGroup().location

var catalogue = loadJsonContent('assignments.json')
var chosen = catalogue.archetypes[archetype]
var regions = empty(allowedLocations) ? {} : {
  allowedLocations: {
    value: allowedLocations
  }
}

resource assignment 'Microsoft.Authorization/policyAssignments@2023-04-01' = {
  name: chosen.assignmentName
  location: location
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    displayName: chosen.displayName
    description: chosen.description
    policyDefinitionId: subscriptionResourceId('Microsoft.Authorization/policySetDefinitions', catalogue.policySetName)
    enforcementMode: 'Default'
    parameters: union(chosen.parameters, regions, {
      logAnalyticsWorkspaceId: {
        value: logAnalyticsWorkspaceId
      }
    })
    nonComplianceMessages: chosen.nonComplianceMessages
    metadata: {
      archetype: archetype
      generatedFrom: catalogue.generatedFrom
    }
  }
}

resource remediationRoles 'Microsoft.Authorization/roleAssignments@2022-04-01' = [
  for roleId in chosen.roleDefinitionIds: {
    name: guid(assignment.id, roleId)
    properties: {
      roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roleId)
      principalId: assignment.identity.principalId
      principalType: 'ServicePrincipal'
      description: 'Remediation role for policy assignment ${chosen.assignmentName}'
    }
  }
]

output assignmentId string = assignment.id
output principalId string = assignment.identity.principalId
output roleAssignmentIds array = [for (roleId, i) in chosen.roleDefinitionIds: remediationRoles[i].id]
