{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archetypes",
  "description": "Landing-zone archetypes, the profile facts each one allows, and example requirement parameters. Version 1.0.0. Importers may add fields to an archetype (for example which requirements are binding); unknown archetype fields are allowed.",
  "type": "object",
  "required": ["schema_version", "notice", "parameters_basis", "archetypes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "notice": {"type": "string", "minLength": 1},
    "parameters_basis": {"type": "string", "pattern": "^[A-Z]{2,6}(\\.[0-9]+)+$", "description": "Requirement that asks for concrete parameter values."},
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "lab", "constraints", "parameters"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "lab": {"type": "boolean", "description": "True for the archetype the lab deploys."},
          "constraints": {
            "type": "object",
            "description": "Allowed values of profile facts. A profile that breaks one is rejected.",
            "additionalProperties": false,
            "properties": {
              "protection_need": {"type": "array", "items": {"enum": ["normal", "high"]}, "minItems": 1},
              "data_classification": {"type": "array", "items": {"enum": ["public", "internal", "confidential"]}, "minItems": 1},
              "internet_facing": {"type": "array", "items": {"type": "boolean"}, "minItems": 1},
              "stores_data": {"type": "array", "items": {"type": "boolean"}, "minItems": 1},
              "personal_data": {"type": "array", "items": {"type": "boolean"}, "minItems": 1}
            }
          },
          "parameters": {
            "type": "object",
            "required": ["allowed_locations", "minimum_tls_version", "classification_tag"],
            "properties": {
              "allowed_locations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "minimum_tls_version": {"enum": ["1.2", "1.3"]},
              "classification_tag": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
